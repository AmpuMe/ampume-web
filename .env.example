# Shopify Storefront API Configuration
# Get these from your Shopify Admin > Settings > Apps and sales channels > Develop apps

VITE_SHOPIFY_STORE_DOMAIN=ampume.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here

# Site-wide password gate (middleware.js)
# Server-only var — do NOT prefix with VITE_, or Vite will inline it into the
# client bundle and it'll be visible in devtools. Set the real value in
# Vercel Project Settings > Environment Variables for whichever environments
# should be gated (e.g. Preview/staging). Leave unset to disable the gate.
SITE_PASSWORD=
